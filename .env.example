# ============================================================
# .env.example — Environment Variables for Nexus AI Agent
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit your .env file to Git!
# ============================================================

# ── Groq API (Free tier at console.groq.com) ─────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Owner's WhatsApp phone number ────────────────────────────
# Full number WITHOUT the + sign (international format)
# Example: 919876543210  (for +91 9876543210)
OWNER_PHONE=919876543210

# ── Gmail OAuth2 Credentials ─────────────────────────────────
# Follow the README.md Gmail setup section to get these values.
# Create a project at: https://console.cloud.google.com/
GMAIL_CLIENT_ID=your_gmail_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token

# ── Timezone for the daily summary cron job ──────────────────
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: Asia/Kolkata | Asia/Dubai | America/New_York | Europe/London
TIMEZONE=Asia/Kolkata
